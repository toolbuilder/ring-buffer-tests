{
  "name": "@toolbuilder/ring-buffer-tests",
  "version": "0.1.4",
  "description": "Simple test harness for testing ring buffer implementations.",
  "keywords": [
    "ring buffer",
    "circular queue",
    "buffer",
    "iterable",
    "module",
    "harness"
  ],
  "homepage": "https://github.com/toolbuilder/ring-buffer-tests#readme",
  "bugs": {
    "url": "https://github.com/toolbuilder/ring-buffer-tests/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toolbuilder/ring-buffer-tests.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run check:types && pnpm run build && pnpm test",
    "check:types": "tsc",
    "release": "changelogen --release --no-github",
    "test": "node --test 'test/**/*.test.js'",
    "validate:package": "npx -y publint && npx -y @arethetypeswrong/cli --pack . --profile esm-only"
  },
  "dependencies": {
    "dequal": "^2.0.2",
    "iterablefu": "^0.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "changelogen": "^0.6.1",
    "typescript": "^5.0.0"
  }
}
